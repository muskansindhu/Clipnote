# --- required ---------------------------------------------------------------
# Any Postgres connection string. The legacy names below still work.
DATABASE_URL=postgresql://clipnote:clipnote@localhost:5433/clipnote
JWT_SECRET=change-me-to-a-long-random-string

# --- legacy database names (used when DATABASE_URL is not set) ---------------
# IPv6_SUPABASE_CONNECTION_STRING=
# IPv4_SUPABASE_CONNECTION_STRING=   # used when FLASK_ENV=production
# SUPABASE_CONNECTION_STRING=

# --- language model ----------------------------------------------------------
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# LLM_PROVIDER=openai              # "stub" = offline placeholder text for local demos

# --- transcripts -------------------------------------------------------------
# TRANSCRIPT_PROVIDERS=youtube_transcript_api,apify   # tried in this order
APIFY_TOKEN=

# --- transcript cache --------------------------------------------------------
# STORAGE_BACKEND=s3               # "filesystem" stores transcripts under LOCAL_DATA_DIR
S3_BUCKET=
ACCESS_KEY=
SECRET_KEY=
# LOCAL_DATA_DIR=./.local-data

# --- Google sign-in (optional) -----------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_DISCOVERY_URL=https://accounts.google.com/.well-known/openid-configuration
